# Copia este archivo como .env y ajusta los valores.
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-esta-clave-jwt-en-produccion

# Conexión a PostgreSQL (Neon). Pide estos datos al equipo / revisa tu panel de Neon.
DATABASE_URL=postgresql://usuario:password@host/nombre_bd?sslmode=require

# Pagos
COMISION_POR_DEFECTO=10
# Pasarela de tarjeta simulada: en producción debe ser false.
SIMULAR_PASARELA=true

# Solo para `docker compose --profile pruebas` (PostgreSQL local de pruebas).
POSTGRES_PASSWORD=sportmatch_local
